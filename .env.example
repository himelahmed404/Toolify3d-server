# API (Express + Socket.IO) — copy to .env and fill in. Never commit real secrets.

PORT=5000
NODE_ENV=development

# Comma-separated store + admin origins (CORS + Socket.IO)
CLIENT_URL=http://localhost:3000,http://localhost:3001

# Comma-separated Better Auth origins (session validation)
BETTER_AUTH_URL=http://localhost:3000,http://localhost:3001

MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=1h

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
ORDER_TO_EMAIL=
ORDER_FROM_EMAIL=

FIREBASE_STORAGE_BUCKET=

# Prefer this on Render / PaaS (full service-account JSON as one line/string)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Local alternative: path to service-account JSON file (gitignored)
# GOOGLE_APPLICATION_CREDENTIALS=./fireBase.json
